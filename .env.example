# Groq Vision API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Groq Vision Model Identifier (Default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/reuseai

# Optional PostgreSQL Connection Timeout in Seconds (Default: 5)
DB_CONNECT_TIMEOUT=5

# Application Environment (development | production)
APP_ENV=development
DATABASE_URL = your_postgresql_connection_url_here
